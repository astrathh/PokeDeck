{
  "name": "deck-multiconta",
  "version": "0.1.1",
  "private": true,
  "description": "PokeDeck: navegador multiconta para o Pokeidle",
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit",
    "dist": "electron-vite build && electron-builder --win nsis --publish never",
    "test:auto": "node tests/deck-auto.test.mjs && node tests/deck-perf.test.mjs",
    "release": "electron-vite build && electron-builder --win nsis --publish always"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^45.3.1",
    "electron-builder": "^25.1.8",
    "electron-vite": "^2.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "typescript": "^5.5.4",
    "vite": "^5.3.5"
  },
  "build": {
    "appId": "local.deck.multiconta",
    "productName": "PokeDeck",
    "directories": {
      "buildResources": "build"
    },
    "files": [
      "out/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "PokeDeck",
      "artifactName": "PokeDeck-Setup-${version}.${ext}"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "astrathh",
        "repo": "PokeDeck",
        "releaseType": "release"
      }
    ],
    "extraResources": [
      {
        "from": "resources/deck-auto",
        "to": "deck-auto"
      }
    ]
  },
  "dependencies": {
    "electron-updater": "^6.8.11"
  }
}
